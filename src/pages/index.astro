---
import { ArrowRight, Bot, Boxes, Database, FileText, GitBranch, LockKeyhole, MonitorDown, Sparkles } from 'lucide-react';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent } from '@/components/ui/card';

const base = import.meta.env.BASE_URL;
const path = (href: string) => href === '/' ? base : `${base}${href.replace(/^\//, '')}`;
const screenshots = {
  overview: path('/assets/screenshots/overview-dark.png'),
  board: path('/assets/screenshots/board.png'),
  import: path('/assets/screenshots/import-markdown.png'),
  permissions: path('/assets/screenshots/permissions.png'),
  audit: path('/assets/screenshots/audit.png'),
  knowledge: path('/assets/screenshots/knowledge.png'),
  graph: path('/assets/screenshots/graph.png'),
};

const painPoints = [
  'Markdown 清单越写越长，Agent 每次都要读大量无关文本。',
  '任务状态藏在文字里，人很难一眼看清项目整体进度。',
  'Agent 修改状态缺少统一入口，权限、审计、同步都容易散掉。',
];

const features = [
  ['Markdown 一键导入', '把现有任务清单解析成可审阅草稿，再确认入库。', FileText],
  ['可视化任务看板', '看板、导航、全景图三种视角掌握任务状态与依赖。', Boxes],
  ['Agent 三通道', 'MCP、HTTP、CLI 访问同一业务层，界面即时同步。', Bot],
  ['受控权限', 'Agent 默认只读，写操作按项目、按 action 显式授权。', LockKeyhole],
  ['本地离线存储', '数据落在项目目录 `.taskboard/`，可随 Git 与团队同步。', Database],
  ['审计日志', '谁在什么时候改了什么，全部追加记录，可回看可导出。', GitBranch],
];
---

<SiteLayout
  title="TangoForge | AI 协作任务看板"
  description="TangoForge 是面向 Vibe Coding 的本地任务管理中间件，把 Markdown 任务清单变成可视化看板，并为 AI Agent 提供 MCP、HTTP、CLI 三通道受控接入。"
>
  <section class="container-page grid min-h-[calc(100vh-4rem)] items-center gap-12 py-16 lg:grid-cols-[0.88fr_1.12fr]">
    <div>
      <div class="mb-5 flex flex-wrap gap-2">
        <Badge variant="secondary">Local-first</Badge>
        <Badge variant="secondary">MCP / HTTP / CLI</Badge>
        <Badge variant="secondary">v0.7.0</Badge>
      </div>
      <h1 class="max-w-4xl text-5xl font-semibold leading-tight tracking-normal md:text-6xl">
        给 Vibe Coding 准备的 AI 协作任务看板。
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
        一键导入已有 Markdown 任务清单，变成可拖拽、可检索、可审计的本地任务池；人类用桌面客户端规划进度，AI Agent 通过 MCP、HTTP、CLI 以受控权限读写同一份数据。
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="https://github.com/PeiJingbobo/TangoForge/releases/tag/v0.7.0"
          class="inline-flex h-11 items-center justify-center gap-2 whitespace-nowrap rounded-full bg-primary px-8 text-sm font-semibold text-white shadow-card transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          target="_blank"
          rel="noreferrer"
        >
          下载 v0.7.0
          <MonitorDown className="h-4 w-4 text-white" />
        </a>
        <a
          href="https://github.com/PeiJingbobo/TangoForge"
          class="inline-flex h-11 items-center justify-center gap-2 whitespace-nowrap rounded-full border border-border bg-card px-8 text-sm font-semibold shadow-card transition-colors hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          target="_blank"
          rel="noreferrer"
        >
          去 GitHub 点亮 Star
          <ArrowRight className="h-4 w-4" />
        </a>
      </div>
      <p class="mt-4 text-sm text-muted-foreground">支持 macOS Apple Silicon 与 Windows x64 安装包。</p>
    </div>

    <div class="relative">
      <div class="relative overflow-hidden rounded-sm border bg-card shadow-pop">
        <img src={screenshots.overview} alt="TangoForge 项目概览界面" class="aspect-[16/10] w-full object-cover" />
      </div>
    </div>
  </section>

  <section class="border-y bg-secondary/40 py-16">
    <div class="container-page grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground">Why</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-normal md:text-4xl">Markdown 清单很好上手，但不适合长期交给 Agent 协作。</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {painPoints.map((item, index) => (
          <Card>
            <CardContent className="p-5">
              <span class="text-sm font-semibold text-muted-foreground">0{index + 1}</span>
              <p class="mt-4 text-sm leading-7 text-muted-foreground">{item}</p>
            </CardContent>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
      <div>
        <Badge variant="secondary">Import</Badge>
        <h2 class="mt-4 text-3xl font-semibold tracking-normal md:text-4xl">从 Markdown 到任务池，不必推倒重来。</h2>
        <p class="mt-4 leading-7 text-muted-foreground">
          TangoForge 会解析你已有的任务 Markdown，先生成可审阅草稿，确认后再入库。既保留原来的工作习惯，又让任务变成结构化数据。
        </p>
      </div>
      <div class="overflow-hidden rounded-lg border bg-card shadow-card">
        <img src={screenshots.import} alt="TangoForge Markdown 导入界面" class="aspect-[16/10] w-full object-cover" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="border-y bg-secondary/40 py-16">
    <div class="container-page">
      <div class="max-w-2xl">
        <Badge variant="secondary">Features</Badge>
        <h2 class="mt-4 text-3xl font-semibold tracking-normal md:text-4xl">人看得清楚，Agent 操作得准。</h2>
        <p class="mt-4 leading-7 text-muted-foreground">
          任务状态、项目资料、权限和审计被放进同一个本地协作层，AI 不再只是在一坨文本里猜上下文。
        </p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {features.map(([title, body, Icon]) => (
          <Card>
            <CardContent className="p-6">
              <div class="grid h-10 w-10 place-items-center rounded-sm bg-primary text-primary-foreground">
                <Icon className="h-5 w-5" />
              </div>
              <h3 class="mt-5 text-xl font-semibold tracking-normal">{title}</h3>
              <p class="mt-3 text-sm leading-7 text-muted-foreground">{body}</p>
            </CardContent>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page grid gap-6 py-16 lg:grid-cols-2">
    {[
      ['可视化看板', '规划任务、拖动流转、查看层级状态。', screenshots.board],
      ['知识库检索', '把任务关联资料变成可被 Agent 检索的项目记忆。', screenshots.knowledge],
      ['权限控制', '按项目授权 Agent action，默认只读更安心。', screenshots.permissions],
      ['审计日志', '所有写操作记录 actor、action、target、result。', screenshots.audit],
    ].map(([title, body, src]) => (
      <Card className="overflow-hidden">
        <CardContent className="p-0">
          <img src={src} alt={`TangoForge ${title}界面`} class="aspect-[16/10] w-full object-cover" loading="lazy" />
          <div class="p-5">
            <h3 class="text-xl font-semibold tracking-normal">{title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{body}</p>
          </div>
        </CardContent>
      </Card>
    ))}
  </section>

  <section class="border-y bg-primary py-16 text-primary-foreground">
    <div class="container-page grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <Sparkles className="h-8 w-8" />
        <h2 class="mt-5 text-3xl font-semibold tracking-normal md:text-4xl">本地守护进程是人类与 Agent 之间的桥梁。</h2>
        <p class="mt-4 leading-7 text-primary-foreground/75">
          App 不需要一直前台运行。AI 需要操作任务时，后台服务可以被唤起；元数据保存在当前项目目录，团队可以通过 Git 同步，每个项目天然隔离。
        </p>
      </div>
      <div class="grid gap-3 text-sm">
        {[
          ['Desktop Client', '看板 / 导航 / 全景图 / 设置 / 权限'],
          ['Local Daemon', '识别 → 项目校验 → 权限 → 审计 → WebSocket 同步'],
          ['AI Agent', 'Claude Code / Cursor / Copilot / CLI，经 MCP、HTTP、CLI 接入'],
          ['Project Data', '.taskboard/ 随项目存储，可提交到 Git'],
        ].map(([name, body]) => (
          <div class="rounded-md border border-white/20 bg-white/10 p-4">
            <p class="font-semibold">{name}</p>
            <p class="mt-1 text-primary-foreground/70">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page grid gap-8 py-16 lg:grid-cols-3">
    <div>
      <h2 class="text-3xl font-semibold tracking-normal">现在就可以下载体验。</h2>
      <p class="mt-4 leading-7 text-muted-foreground">
        v0.7.0 已在 GitHub Releases 发布，Windows 与 Mac 可以开箱即用。仓库地址也在那里，欢迎测试和点 Star。
      </p>
    </div>
    <Card className="lg:col-span-2">
      <CardContent className="grid gap-4 p-6 md:grid-cols-3">
        <a class="rounded-md border p-4 transition-colors hover:bg-accent" href="https://github.com/PeiJingbobo/TangoForge/releases/tag/v0.7.0" target="_blank" rel="noreferrer">
          <h3 class="font-semibold">下载 v0.7.0</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">获取 macOS dmg 与 Windows 安装包。</p>
        </a>
        <a class="rounded-md border p-4 transition-colors hover:bg-accent" href={path('/docs')}>
          <h3 class="font-semibold">阅读文档</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">了解安装、Agent 接入与架构。</p>
        </a>
        <a class="rounded-md border p-4 transition-colors hover:bg-accent" href="https://github.com/PeiJingbobo/TangoForge" target="_blank" rel="noreferrer">
          <h3 class="font-semibold">查看源码</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">如果项目有帮助，欢迎点亮 Star。</p>
        </a>
      </CardContent>
    </Card>
  </section>
</SiteLayout>
